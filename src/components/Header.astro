---
import { SITE } from '../site.config';
const path = Astro.url.pathname;
const isMap = path === '/map';
---

<header>
  <a class="wordmark" href="/">{SITE.name}<span class="tilde">&nbsp;/&nbsp;</span><em>brain map</em></a>
  <nav class="data">
    <a href="/" aria-current={!isMap ? 'page' : undefined}>log</a>
    <a href="/map" aria-current={isMap ? 'page' : undefined}>map</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--line);
    max-width: 72rem;
    margin: 0 auto;
  }
  .wordmark {
    text-decoration: none;
    font-size: var(--text-base);
  }
  .wordmark em {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
  }
  .tilde {
    color: var(--ink-faint);
  }
  nav {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }
  nav a {
    text-decoration: none;
    color: var(--ink-dim);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
</style>
