---
const path = Astro.url.pathname;
const current = (p: string) => (path === p || path === `${p}/` ? 'page' : undefined);
---

<header class="data">
  <a class="wordmark" href="/"
    ><span class="user">gray</span><span class="at">@</span><span class="host">brainmap</span><span class="path">:~$</span><span
      class="cursor"
      aria-hidden="true"></span></a
  >
  <!-- Terminal narration. Every line lives here, including the command and
       its prompt, so the prompt scrolls away with its own command exactly as
       it would in a shell. Decorative, so aria-hidden. -->
  <div id="term" class="term" aria-hidden="true"></div>
  <nav>
    <a href="/bio" aria-current={current('/bio')}>bio</a>
    <a href="/resume" aria-current={current('/resume')}>resume</a>
    <a href="/contact" aria-current={current('/contact')}>contact</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .wordmark {
    text-decoration: none;
    white-space: nowrap;
    align-self: center;
  }
  .user {
    color: var(--prompt);
  }
  .at,
  .path {
    color: var(--ink-faint);
  }
  .host {
    color: var(--ink);
  }
  .wordmark .cursor {
    margin-left: 2px;
  }
  /* While the terminal line is running, its own cursor is the live one. */
  header.has-log .wordmark .cursor {
    display: none;
  }
  /* Two-line window, bottom-anchored: appending a line pushes the older one
     up and out, which is the scroll. Children are divs, not spans, so they
     stack even if this rule never lands. */
  .term {
    flex: 1;
    min-width: 0;
    align-self: flex-start;
    /* Optical: pull level with the nav's cap height rather than its box. */
    margin-top: -0.15em;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    color: var(--ink-faint);
  }
  .term:empty {
    display: none;
  }
  /* Reserved only while narrating, so other pages keep a one-line header and
     the map's header does not resize mid-tour. */
  header.has-log .term {
    height: 2.8em;
  }
  /* The wordmark IS the prompt. Once the command has been issued it belongs to
     that command's line and scrolls away with it, so the static one goes. */
  header.has-log .wordmark {
    display: none;
  }
  .term :global(.log-line) {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    transition:
      opacity 280ms cubic-bezier(0.2, 0, 0, 1),
      translate 280ms cubic-bezier(0.2, 0, 0, 1);
  }
  /* The displaced line stays readable but stops competing. */
  .term :global(.log-line:not(:last-child)) {
    opacity: 0.38;
  }
  .term :global(.log-line.enter) {
    opacity: 0;
    translate: 0 1em;
  }
  .term :global(.log-line .p-user) {
    color: var(--prompt);
  }
  .term :global(.log-line .p-host) {
    color: var(--ink);
  }
  .term :global(.log-line .p-path) {
    color: var(--ink-faint);
  }
  .term :global(.log-line .cmd) {
    color: var(--ink-dim);
  }
  @media (prefers-reduced-motion: reduce) {
    .term :global(.log-line) {
      transition: none;
    }
    .term :global(.log-line.enter) {
      opacity: 1;
      translate: none;
    }
  }
  @media (max-width: 720px) {
    .term {
      display: none;
    }
  }
  nav {
    display: flex;
    gap: var(--space-4);
  }
  nav a {
    text-decoration: none;
    color: var(--ink-dim);
  }
  nav a::before {
    content: './';
    color: var(--ink-faint);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
</style>
