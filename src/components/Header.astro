---
const path = Astro.url.pathname;
const current = (p: string) => (path === p || path === `${p}/` ? 'page' : undefined);
---

<header class="data">
  <a class="wordmark" href="/"
    ><span class="user">gray</span><span class="at">@</span><span class="host">brainmap</span><span class="path">:~$</span><span
      class="cursor"
      aria-hidden="true"></span></a
  >
  <!-- Terminal narration: the map's intro types a command here, then streams
       one line per era upward like log output. Decorative, so aria-hidden. -->
  <span id="term" class="term" aria-hidden="true">
    <span id="term-cmd" class="term-cmd"></span>
    <span id="term-log" class="term-log"></span>
  </span>
  <nav>
    <a href="/bio" aria-current={current('/bio')}>bio</a>
    <a href="/resume" aria-current={current('/resume')}>resume</a>
    <a href="/contact" aria-current={current('/contact')}>contact</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .wordmark {
    text-decoration: none;
    white-space: nowrap;
  }
  .user {
    color: var(--prompt);
  }
  .at,
  .path {
    color: var(--ink-faint);
  }
  .host {
    color: var(--ink);
  }
  .wordmark .cursor {
    margin-left: 2px;
  }
  /* While the terminal line is running, its own cursor is the live one. */
  :global(header.has-term) .wordmark .cursor {
    display: none;
  }
  /* The command types on the prompt line; log lines stack beneath it and
     scroll up out of a two-line window. Bottom-anchored, so appending a line
     pushes the older one up for free. */
  .term {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-self: flex-start;
  }
  .term-cmd,
  .term-log :global(.log-line) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* Data line: fixed-width digits keep the year from jittering. */
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
  }
  .term-cmd {
    color: var(--ink-dim);
  }
  .term-cmd:empty {
    display: none;
  }
  .term-log {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    color: var(--ink-faint);
  }
  /* Reserved only once narration starts, so other pages keep a one-line header
     and the map's header does not resize mid-tour. */
  :global(header.has-log) .term-log {
    height: 2.7em;
  }
  .term-log :global(.log-line) {
    display: block;
    transition:
      opacity 320ms cubic-bezier(0.2, 0, 0, 1),
      translate 320ms cubic-bezier(0.2, 0, 0, 1);
  }
  /* The older line stays legible but stops competing with the current one. */
  .term-log :global(.log-line:not(:last-child)) {
    opacity: 0.4;
  }
  .term-log :global(.log-line.enter) {
    opacity: 0;
    translate: 0 0.6em;
  }
  @media (prefers-reduced-motion: reduce) {
    .term-log :global(.log-line) {
      transition: none;
    }
    .term-log :global(.log-line.enter) {
      opacity: 1;
      translate: none;
    }
  }
  @media (max-width: 720px) {
    /* Not enough room to narrate beside the nav; the map still tells the story. */
    .term {
      display: none;
    }
  }
  nav {
    display: flex;
    gap: var(--space-4);
  }
  nav a {
    text-decoration: none;
    color: var(--ink-dim);
  }
  nav a::before {
    content: './';
    color: var(--ink-faint);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
</style>
