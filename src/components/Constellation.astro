---
/**
 * The constellation thread: a build-time SVG of one node's immediate link
 * neighborhood, drawn in the node's domain color. Signature element per
 * DESIGN.md, and working navigation: every neighbor is a link.
 *
 * Deterministic layout: neighbors on an arc around the center node, angle by
 * index. No client JS.
 */
interface Neighbor {
  id: string;
  title: string;
  domain: string;
  teaser: boolean;
}
interface Props {
  domain: string;
  neighbors: Neighbor[];
}
const { domain, neighbors } = Astro.props;

const W = 640;
// Compact when the neighborhood is small; the strip earns height with content.
const H = neighbors.length <= 2 ? 96 : 150;
const cx = W / 2;
const cy = H / 2;
const r = neighbors.length <= 2 ? 34 : 52;

const placed = neighbors.map((n, i) => {
  const angle = (i / Math.max(neighbors.length, 1)) * Math.PI * 2 - Math.PI / 2;
  return {
    ...n,
    x: cx + Math.cos(angle) * r * (neighbors.length === 1 ? 1 : 1.6),
    y: cy + Math.sin(angle) * r * 0.75,
  };
});
---

{
  neighbors.length > 0 && (
    <figure class="constellation" style={`--lamp: var(--lamp-${domain})`}>
      <figcaption class="data">connected ideas</figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Connected ideas">
        {placed.map((n) => (
          <line x1={cx} y1={cy} x2={n.x} y2={n.y} />
        ))}
        <circle class="center" cx={cx} cy={cy} r="5" />
        {placed.map((n) =>
          n.teaser ? (
            <g class="neighbor neighbor--teaser">
              <circle cx={n.x} cy={n.y} r="3.5" />
              <text x={n.x} y={n.y - 10} text-anchor="middle">
                {n.title}
              </text>
            </g>
          ) : (
            <a href={`/idea/${n.id}`}>
              <g class="neighbor" style={`--nlamp: var(--lamp-${n.domain})`}>
                <circle cx={n.x} cy={n.y} r="3.5" />
                <text x={n.x} y={n.y - 10} text-anchor="middle">
                  {n.title}
                </text>
              </g>
            </a>
          ),
        )}
      </svg>
    </figure>
  )
}

<style>
  .constellation {
    margin: var(--space-8) 0 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--line-faint);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  line {
    stroke: color-mix(in srgb, var(--lamp) 40%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .center {
    fill: var(--lamp);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--lamp) 70%, transparent));
  }
  .neighbor circle {
    fill: var(--nlamp, var(--ink-faint));
  }
  .neighbor--teaser circle {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1.2;
  }
  .neighbor text {
    font-family: var(--font-data);
    font-size: 11px;
    fill: var(--ink-dim);
  }
  a:hover text,
  a:focus text {
    fill: var(--ink);
    text-decoration: underline;
  }
  figcaption {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }
</style>
