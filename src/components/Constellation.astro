---
/**
 * The constellation thread: a build-time SVG of one node's immediate link
 * neighborhood, drawn in the node's domain color. Signature element per
 * DESIGN.md, and working navigation: every neighbor is a link.
 *
 * Deterministic layout: neighbors on an arc around the center node, angle by
 * index. No client JS.
 */
interface Neighbor {
  id: string;
  title: string;
  domain: string;
  teaser: boolean;
}
interface Props {
  domain: string;
  neighbors: Neighbor[];
}
const { domain, neighbors } = Astro.props;

const W = 640;
const N = neighbors.length;
const cx = W / 2;

/**
 * Ellipse sized by how many labels have to fit on it, not by a fixed radius.
 *
 * A fixed 52px radius squashed to 0.75 vertically put ten neighbours inside a
 * 166 by 39 box in the middle of a 640-wide canvas: every label landed on top
 * of its neighbours, and four of the ten dots ended up underneath somebody
 * else's text, where a click reached the wrong page. The labels run up to
 * about 175px at 11px mono, so the horizontal radius has to hold two of them
 * side by side and the vertical one has to give each ring of the ellipse its
 * own line.
 */
const RX = N <= 1 ? 0 : N <= 2 ? 150 : N <= 4 ? 210 : 232;
const RY = N <= 2 ? 26 : Math.min(34 + N * 11, 150);
// Labels sit 10px above their dot and stand about 11px tall, so the canvas
// needs the diameter plus roughly 21px of clearance at the top. 48 leaves a
// little air without opening a gap the strip has not earned.
const H = N <= 2 ? 96 : 2 * RY + 48;
const cy = H / 2;

const placed = neighbors.map((n, i) => {
  const angle = (i / Math.max(N, 1)) * Math.PI * 2 - Math.PI / 2;
  return {
    ...n,
    x: cx + Math.cos(angle) * RX,
    y: cy + Math.sin(angle) * RY,
  };
});
---

{
  neighbors.length > 0 && (
    <figure class="constellation" style={`--lamp: var(--lamp-${domain})`}>
      <figcaption class="data" id="constellation-caption">
        connected ideas
      </figcaption>
      {/* No role="img": that would make the whole subtree presentational and
          take the neighbour links out of the accessibility tree, leaving a
          keyboard user focusing things a screen reader cannot name. The
          figcaption is the group's label instead. */}
      <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby="constellation-caption">
        {placed.map((n) => (
          <line x1={cx} y1={cy} x2={n.x} y2={n.y} />
        ))}
        <circle class="center" cx={cx} cy={cy} r="5" />
        {placed.map((n) =>
          n.teaser ? (
            <g class="neighbor neighbor--teaser">
              <circle cx={n.x} cy={n.y} r="3.5" />
              <text x={n.x} y={n.y - 10} text-anchor="middle">
                {n.title}
              </text>
            </g>
          ) : (
            <a href={`/idea/${n.id}`} aria-label={n.title}>
              {/* Target is the dot plus its label: about 27px tall and 77 to
                  140 wide, which clears the 24x24 floor. It deliberately gets
                  no padded hit area. A rect big enough to reach 40px overlaps
                  its neighbours on a crowded neighbourhood, and once two of
                  them overlap the upper one swallows clicks aimed at the dot
                  below it: on the ten-neighbour node that silently broke six
                  of the ten links. Below 720px, where a finger is the likely
                  input, .thread-list replaces this with 40px rows. */}
              <g class="neighbor" style={`--nlamp: var(--lamp-${n.domain})`}>
                <circle cx={n.x} cy={n.y} r="3.5" />
                <text x={n.x} y={n.y - 10} text-anchor="middle">
                  {n.title}
                </text>
              </g>
            </a>
          ),
        )}
      </svg>
      {/* The SVG scales with its column, and the labels scale with it: below
          about 720px the 11px text drops under 10, and at 320 it is closer to
          5. Rather than let the signature element become unreadable, the same
          neighbourhood switches to a plain list at those widths. Exactly one
          of the two is in the document at a time, so neither the tab order nor
          a screen reader ever meets the links twice. */}
      <ul class="thread-list">
        {placed.map((n) => (
          <li>
            <span
              class:list={['dot', n.teaser && 'dot--teaser']}
              style={`--nlamp: var(--lamp-${n.domain})`}
              aria-hidden="true"
            />
            {n.teaser ? <span class="teaser-name">{n.title}</span> : <a href={`/idea/${n.id}`}>{n.title}</a>}
          </li>
        ))}
      </ul>
    </figure>
  )
}

<style>
  .constellation {
    margin: var(--space-8) 0 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--line-faint);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  line {
    stroke: color-mix(in srgb, var(--lamp) 40%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .center {
    fill: var(--lamp);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--lamp) 70%, transparent));
  }
  .neighbor circle {
    fill: var(--nlamp, var(--ink-faint));
  }
  .neighbor--teaser circle {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1.2;
  }
  .neighbor text {
    font-family: var(--font-data);
    font-size: 11px;
    fill: var(--ink-dim);
  }
  a:hover text,
  a:focus text {
    fill: var(--ink);
    text-decoration: underline;
  }
  figcaption {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }

  /* The narrow-width form of the same neighbourhood. Rows are full width and
     40px tall, which is the target the SVG's 3.5px dots could never offer on
     a phone anyway. */
  .thread-list {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }
  .thread-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 40px;
    border-bottom: 1px solid var(--line-faint);
  }
  .thread-list li:last-child {
    border-bottom: 0;
  }
  .thread-list .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
    background: var(--nlamp, transparent);
  }
  /* A neighbour with no page of its own is named and not linked, so its dot
     is hollow to match the way an unshipped idea reads on the map. */
  .thread-list .dot--teaser {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--ink-faint);
  }
  .thread-list a {
    font-size: var(--text-sm);
    color: var(--ink);
    text-decoration: none;
  }
  .thread-list a:hover {
    text-decoration: underline;
  }
  .thread-list .teaser-name {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  /* One or the other, never both. */
  .thread-list {
    display: none;
  }
  @media (max-width: 720px) {
    svg {
      display: none;
    }
    .thread-list {
      display: block;
    }
  }
</style>
