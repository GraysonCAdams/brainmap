---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import { getCollection } from 'astro:content';
import { SITE, techLabel } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL. Falls back to the site-wide card. */
  ogImage?: string;
  /** 'website' for most pages, 'article' for a write-up. */
  ogType?: string;
  noindex?: boolean;
  /** Extra structured data, merged into the graph this layout assembles. */
  jsonld?: object | object[];
  /** ISO dates, for the article Open Graph tags. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = SITE.description,
  ogImage,
  ogType,
  noindex = false,
  jsonld,
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.name} · ${SITE.title}`;
/**
 * build.format is 'file', so at render time this carries the `.html` that the
 * output file has and the served URL does not: /idea/ampere.html, not
 * /idea/ampere. Left alone it published a canonical URL that disagreed with
 * the sitemap, and every /idea/ lookup below missed, which cost node pages
 * their article tags, their project structured data and their markdown
 * alternate. Normalise once, here, to the URL a reader actually sees.
 */
const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const origin = new URL('/', Astro.site).toString().replace(/\/$/, '');
const canonical = new URL(path, Astro.site).toString();
const cardImage = new URL(ogImage ?? SITE.ogImage, Astro.site).toString();

/**
 * Structured data is assembled here rather than at each call site. Every fact
 * it states already lives in the node frontmatter or in site.config, so a
 * per-page prop would be that same data copied by hand, which is how a schema
 * block quietly ends up describing a page it no longer matches. Pages pass
 * `jsonld` only for objects this layout cannot derive.
 */
const PERSON_ID = `${origin}/#person`;
const WEBSITE_ID = `${origin}/#website`;

// The identity pages: the two places a reader (or an entity resolver) is
// looking for the person rather than for a project.
const isIdentityPage = path === '/' || path === '/bio';

const nodeSlug = path.startsWith('/idea/') ? path.slice('/idea/'.length) : null;
const all = nodeSlug || isIdentityPage ? await getCollection('nodes') : [];
const node = nodeSlug ? all.find((n) => n.id === nodeSlug) : undefined;

/** Slugs that name a real language, so programmingLanguage stays truthful. */
const LANGUAGE_TECH = new Set([
  'typescript',
  'javascript',
  'python',
  'php',
  'java',
  'go',
  'rust',
  'ruby',
  'csharp',
  'bash',
  'powershell',
  'swift',
  'kotlin',
  'sql',
]);

const STATUS_LABEL: Record<string, string> = {
  idea: 'Idea',
  building: 'In development',
  shipped: 'Shipped',
  retired: 'Retired',
};

function personNode() {
  const sameAs = [`https://github.com/${SITE.github}`];
  // An empty linkedin handle would render as a bare /in/ URL that 404s, which
  // is worse than the property being absent.
  if (SITE.linkedin) sameAs.push(`https://www.linkedin.com/in/${SITE.linkedin}`);
  // Counted across public nodes so the list reflects what is actually written
  // up here, not an aspirational skills section.
  const counts = new Map<string, number>();
  for (const n of all) {
    if (n.data.visibility !== 'public') continue;
    for (const t of n.data.tech) counts.set(t, (counts.get(t) ?? 0) + 1);
  }
  const knowsAbout = [...counts.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 24)
    .map(([t]) => techLabel(t));
  return {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: SITE.name,
    url: `${origin}/`,
    jobTitle: SITE.jobTitle,
    worksFor: { '@type': 'Organization', name: SITE.employer },
    alumniOf: { '@type': 'CollegeOrUniversity', name: SITE.alumniOf },
    homeLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Chicago',
        addressRegion: 'IL',
        addressCountry: 'US',
      },
    },
    knowsAbout,
    sameAs,
  };
}

function websiteNode() {
  return {
    '@type': 'WebSite',
    '@id': WEBSITE_ID,
    url: `${origin}/`,
    name: `${SITE.name} · ${SITE.title}`,
    description: SITE.description,
    inLanguage: SITE.lang,
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    license: 'https://creativecommons.org/licenses/by-nc-nd/4.0/',
  };
}

function nodeGraph(n: NonNullable<typeof node>) {
  const url = `${origin}/idea/${n.id}`;
  const started = n.data.started.toISOString().slice(0, 10);
  const ended = n.data.ended?.toISOString().slice(0, 10);
  const languages = n.data.tech.filter((t) => LANGUAGE_TECH.has(t)).map(techLabel);

  // Breadcrumb trail follows the crawlable path, not a notional hierarchy:
  // /bio is where every node's link actually lives. A node that is part of a
  // larger one sits under its parent, which is the relationship the page
  // itself states.
  const trail: { name: string; item: string }[] = [
    { name: SITE.title, item: `${origin}/` },
    { name: 'Project log', item: `${origin}/bio` },
  ];
  const parent = n.data.parent ? all.find((p) => p.id === n.data.parent) : undefined;
  if (parent && parent.data.visibility === 'public' && parent.data.detail !== 'parent') {
    trail.push({ name: parent.data.title, item: `${origin}/idea/${parent.id}` });
  }
  trail.push({ name: n.data.title, item: url });

  const project: Record<string, unknown> = {
    '@type': n.data.repo ? 'SoftwareSourceCode' : 'CreativeWork',
    '@id': `${url}#project`,
    name: n.data.title,
    description: n.data.tagline,
    url,
    author: { '@id': PERSON_ID },
    creator: { '@id': PERSON_ID },
    inLanguage: SITE.lang,
    dateCreated: started,
    // An open-ended interval is the honest form for work still running.
    temporalCoverage: ended ? `${started}/${ended}` : `${started}/..`,
    creativeWorkStatus: STATUS_LABEL[n.data.status] ?? n.data.status,
    keywords: [n.data.domain, ...n.data.tags, ...n.data.tech.map(techLabel)],
    license: 'https://creativecommons.org/licenses/by-nc-nd/4.0/',
  };
  if (n.data.repo) {
    project.codeRepository = `https://github.com/${n.data.repo}`;
    if (languages.length) project.programmingLanguage = languages;
  }
  if (n.data.org) {
    project.sourceOrganization = { '@type': 'Organization', name: n.data.org };
  }

  return [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: n.data.title,
      description: n.data.tagline,
      isPartOf: { '@id': WEBSITE_ID },
      inLanguage: SITE.lang,
      about: { '@id': `${url}#project` },
      breadcrumb: { '@id': `${url}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: trail.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.name,
        item: t.item,
      })),
    },
    project,
  ];
}

const graph: object[] = [websiteNode()];
if (isIdentityPage) graph.push(personNode());
if (node) graph.push(...nodeGraph(node));
if (jsonld) graph.push(...(Array.isArray(jsonld) ? jsonld : [jsonld]));
const structuredData = { '@context': 'https://schema.org', '@graph': graph };

// A node page is an article whether or not the call site says so, and its
// dates are already in the frontmatter. Explicit props still win.
const resolvedType = ogType ?? (node ? 'article' : 'website');
const resolvedPublished = publishedTime ?? node?.data.started.toISOString();
const resolvedModified =
  modifiedTime ?? (node ? (node.data.ended ?? node.data.started).toISOString() : undefined);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="me" href={`https://github.com/${SITE.github}`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {
      /* The markdown mirror is the same page without the chrome; an assistive
         fetcher that follows this gets the prose and none of the canvas. */
      node && (
        <link rel="alternate" type="text/markdown" href={`/idea/${node.id}.md`} title="Markdown" />
      )
    }

    <meta property="og:type" content={resolvedType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${SITE.name} · ${SITE.title}`} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={cardImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    {resolvedType === 'article' && resolvedPublished && (
      <meta property="article:published_time" content={resolvedPublished} />
    )}
    {resolvedType === 'article' && resolvedModified && (
      <meta property="article:modified_time" content={resolvedModified} />
    )}
    {resolvedType === 'article' && <meta property="article:author" content={SITE.name} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

    <script is:inline>
      // Embed mode: the map's node modal iframes pages and the page hides its
      // own chrome (CSS keys off this attribute).
      //
      // Being framed is the real condition, so test for it directly. Keying
      // only off ?embed=1 worked for the page the map opens and broke on the
      // very next click: a link inside the frame navigates to a plain URL, the
      // flag is lost, and the site header renders inside the modal window.
      //
      // In <head> so the attribute exists before body paints, otherwise the
      // chrome flashes once on every embedded navigation.
      var framed = false;
      try {
        framed = window.self !== window.top;
      } catch (e) {
        framed = true; // cross-origin access throwing means we are framed
      }
      if (framed || location.search.includes('embed=1'))
        document.documentElement.dataset.embed = '1';
    </script>
  </head>
  <body>
    <script is:inline>
      // Inside the frame, internal navigation belongs to the MAP, not to the
      // iframe. Letting the frame navigate itself leaves the outer address bar
      // and history pointing at whichever node was opened first, so the URL
      // silently stops describing what is on screen. Hand the click to the
      // parent instead and let it drive.
      if (document.documentElement.dataset.embed === '1' && window.parent !== window) {
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest && ev.target.closest('a[href^="/idea/"]');
          if (!a || ev.metaKey || ev.ctrlKey || ev.shiftKey || a.target === '_blank') return;
          var m = a.getAttribute('href').match(/^\/idea\/([^/?#]+)/);
          if (!m) return;
          ev.preventDefault();
          parent.postMessage({ brainmap: 'open', id: m[1] }, location.origin);
        });
      }
    </script>
    <slot />
  </body>
</html>
