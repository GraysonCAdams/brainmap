---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site.config';
import { DOMAINS } from '../content.config';

// Counts include tags: a node matches every domain it carries.
const all = await getCollection('nodes');
const counts = Object.fromEntries(
  DOMAINS.map((d) => [
    d,
    all.filter((n) => n.data.domain === d || n.data.tags.includes(d)).length,
  ]),
);
const panelDomains = DOMAINS.filter((d) => counts[d] > 0);

// Tech facet: counted across public nodes, most-used first.
const techCounts = new Map<string, number>();
for (const n of all) {
  if (n.data.visibility !== 'public') continue;
  for (const t of n.data.tech) techCounts.set(t, (techCounts.get(t) ?? 0) + 1);
}
const panelTech = [...techCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14);
---

<Base>
  <Header />
  <main>
    <div id="map-root">
      <noscript>
        The map needs JavaScript. Everything on it is also in <a href="/bio">the bio</a>.
      </noscript>
    </div>

    <!-- cursor-following hover tooltip -->
    <div id="map-tip" class="data" hidden>
      <p class="tip-title"></p>
      <p class="tip-text"></p>
      <p class="tip-tech"></p>
    </div>

    <!-- expanded project: modal overlay, URL updates to the real page -->
    <div id="node-modal" class="node-backdrop" hidden>
      <section class="node-shell" role="dialog" aria-modal="true" aria-label="Project">
        <button class="node-close data" aria-label="Close">esc</button>
        <iframe id="node-frame" title="Project write-up"></iframe>
      </section>
    </div>

    <!-- whoami modal: first-visit overview, dismissable, remembered -->
    <div id="intro" class="intro-backdrop" hidden>
      <section class="intro-modal" role="dialog" aria-modal="true" aria-labelledby="intro-title">
        <p id="intro-title" class="data intro-cmd"><span class="prompt">$</span> whoami</p>
        <p class="intro-name data">{SITE.name}</p>
        <p class="intro-text">
          Lead DevOps engineer who can't stop building things. Every dot on this map is an idea I
          had; the bright ones shipped. Click any of them to see how I actually think through a
          problem: constraints, edge cases, tradeoffs.
        </p>
        <div class="intro-actions data">
          <button id="intro-close" autofocus>[ explore the map ]</button>
          <a href="/bio">./bio</a>
          <a href="/resume">./resume</a>
        </div>
      </section>
    </div>

    <aside id="domain-panel" class="data" aria-label="Filter by domain">
      <button id="panel-toggle" aria-expanded="false">[ domains ]</button>
      <div class="panel-body">
        <p class="panel-title">## domains</p>
        {
          panelDomains.map((d) => (
            <button
              class="drow"
              data-domain-filter={d}
              aria-pressed="false"
              style={`--lamp: var(--lamp-${d})`}
            >
              <i class="dot" aria-hidden="true" />
              <span class="dname">{d}</span>
              <span class="dcount">{counts[d]}</span>
            </button>
          ))
        }
        <p class="panel-hint">multi-tagged ideas match every domain they touch</p>
        <p class="panel-title panel-title-stack">## stack</p>
        <div class="stack-chips">
          {
            panelTech.map(([t, c]) => (
              <button class="tchip" data-tech-filter={t} aria-pressed="false">
                {t}
                <span class="dcount">{c}</span>
              </button>
            ))
          }
        </div>
      </div>
    </aside>

    <!-- timelapse: draggable focus year + stretchable relevance window -->
    <div id="timeline" class="data" aria-label="Time travel">
      <button id="tl-reset">[ reset ]</button>
      <div id="tl-track">
        <div id="tl-ticks"></div>
        <div id="tl-region">
          <div class="tl-edge" id="tl-edge-l" title="drag: how far back stays relevant"></div>
          <div class="tl-edge" id="tl-edge-r" title="drag: how far ahead stays relevant"></div>
        </div>
        <div id="tl-handle" title="drag through time"></div>
      </div>
      <span id="tl-readout">now</span>
    </div>

    <footer class="legend data" aria-label="How to read the map">
      <span><i class="key key-idea"></i>idea</span>
      <span><i class="key key-building"></i>building</span>
      <span><i class="key key-shipped"></i>shipped</span>
      <span><i class="key key-retired"></i>retired</span>
      <span><i class="key key-teaser"></i>in stealth</span>
      <span class="legend-hint">color = domain · size = scope · drag, pinch, scroll</span>
    </footer>
  </main>
</Base>

<script src="../scripts/map.ts"></script>

<script>
  // Intro modal: show until dismissed once on this device.
  const KEY = 'brainmap-intro-dismissed';
  const backdrop = document.getElementById('intro') as HTMLElement;
  const close = () => {
    backdrop.hidden = true;
    localStorage.setItem(KEY, '1');
  };
  if (!localStorage.getItem(KEY)) {
    backdrop.hidden = false;
    document.getElementById('intro-close')?.focus();
  }
  document.getElementById('intro-close')?.addEventListener('click', close);
  backdrop.addEventListener('click', (ev) => {
    if (ev.target === backdrop) close();
  });
  addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && !backdrop.hidden) close();
  });
</script>

<style>
  /* The map page owns the viewport: no document scroll, main fills the rest. */
  :global(body) {
    overflow: hidden;
    height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  main {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    /* graph-paper texture: map surface only, per DESIGN.md */
    background-image:
      linear-gradient(var(--line-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  #map-root {
    position: absolute;
    inset: 0;
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }
  noscript {
    display: grid;
    place-items: center;
    height: 100%;
  }

  #map-tip {
    position: absolute;
    max-width: 17rem;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-top: 2px solid var(--lamp, var(--line));
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-3);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.45);
    pointer-events: none;
    z-index: 6;
    font-size: var(--text-xs);
  }
  #map-tip[hidden] {
    display: none;
  }
  .tip-title {
    color: var(--ink);
    font-weight: 600;
    margin: 0;
  }
  .tip-text {
    color: var(--ink-dim);
    margin: 2px 0 0;
  }
  .tip-tech {
    color: var(--ink-faint);
    margin: 3px 0 0;
  }

  .node-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(6 10 11 / 0.72);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    z-index: 12;
  }
  .node-backdrop[hidden] {
    display: none;
  }
  .node-shell {
    position: relative;
    width: min(52rem, 100%);
    height: min(85%, 60rem);
    background: var(--ground);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.55);
    overflow: hidden;
  }
  .node-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    font: inherit;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: 1px 6px;
    cursor: pointer;
    z-index: 1;
  }
  .node-close:hover {
    color: var(--ink);
  }
  #node-frame {
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--ground);
  }

  .panel-title-stack {
    margin-top: var(--space-3);
  }
  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .tchip {
    font: inherit;
    font-size: 0.68rem;
    color: var(--ink-dim);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: 1px 6px;
    cursor: pointer;
  }
  .tchip .dcount {
    margin-left: 4px;
  }
  .tchip:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
  .tchip[aria-pressed='true'] {
    color: var(--ground);
    background: var(--ink);
    border-color: var(--ink);
  }
  .tchip[aria-pressed='true'] .dcount {
    color: var(--ground);
  }

  .intro-backdrop[hidden] {
    display: none;
  }
  .intro-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(6 10 11 / 0.72);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    z-index: 10;
  }
  .intro-modal {
    width: min(27rem, 100%);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: var(--space-6);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.55);
  }
  .intro-cmd {
    font-size: var(--text-sm);
    color: var(--ink-dim);
    margin: 0;
  }
  .intro-cmd .prompt {
    color: var(--prompt);
  }
  .intro-name {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: var(--space-2) 0 var(--space-3);
  }
  .intro-text {
    font-size: var(--text-sm);
    color: var(--ink-dim);
    margin: 0 0 var(--space-4);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: baseline;
    font-size: var(--text-sm);
  }
  .intro-actions button {
    font: inherit;
    color: var(--ground);
    background: var(--ink);
    border: none;
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .intro-actions button:hover {
    opacity: 0.88;
  }
  .intro-actions a {
    color: var(--ink-dim);
    text-decoration: none;
  }
  .intro-actions a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  #domain-panel {
    position: absolute;
    top: var(--space-3);
    left: var(--space-4);
    width: 13rem;
    font-size: var(--text-xs);
  }
  #panel-toggle {
    display: none;
    font: inherit;
    color: var(--ink-dim);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
  }
  .panel-body {
    background: color-mix(in srgb, var(--surface-raised) 92%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: var(--space-3);
    display: grid;
    gap: 2px;
    max-height: calc(100dvh - 13rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .panel-title {
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-2);
  }
  .drow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: inherit;
    color: var(--ink-dim);
    background: none;
    border: none;
    border-left: 2px solid transparent;
    border-radius: var(--radius-chip);
    padding: 3px var(--space-2);
    cursor: pointer;
    text-align: left;
  }
  .drow:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .drow[aria-pressed='true'] {
    color: var(--ink);
    border-left-color: var(--lamp);
    background: var(--surface);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lamp);
    flex: none;
  }
  .dname {
    flex: 1;
  }
  .dcount {
    color: var(--ink-faint);
  }
  .panel-hint {
    color: var(--ink-faint);
    margin: var(--space-2) 0 0;
    font-size: 0.68rem;
  }

  #timeline {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    width: min(46rem, calc(100% - 2rem));
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--ink-dim);
    background: color-mix(in srgb, var(--surface-raised) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-3);
    z-index: 5;
  }
  #tl-reset {
    font: inherit;
    color: var(--ink-faint);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    white-space: nowrap;
  }
  #tl-reset:hover {
    color: var(--ink);
  }
  #tl-track {
    position: relative;
    flex: 1;
    height: 26px;
    cursor: pointer;
    /* the whole track is a gesture surface; never hand it to the browser */
    touch-action: none;
  }
  #tl-track::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--line);
  }
  #tl-ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  #tl-ticks :global(.tick) {
    position: absolute;
    top: 50%;
    width: 1px;
    height: 6px;
    transform: translateY(-50%);
    background: var(--line);
  }
  #tl-ticks :global(.tick-label) {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.62rem;
    color: var(--ink-faint);
  }
  #tl-region {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 12px;
    background: color-mix(in srgb, var(--prompt) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--prompt) 45%, transparent);
    border-radius: 2px;
  }
  .tl-edge {
    position: absolute;
    top: -4px;
    bottom: -4px;
    width: 8px;
    cursor: ew-resize;
  }
  #tl-edge-l {
    left: -4px;
  }
  #tl-edge-r {
    right: -4px;
  }
  #tl-handle {
    position: absolute;
    top: 50%;
    width: 3px;
    height: 18px;
    transform: translate(-50%, -50%);
    background: var(--ink);
    border-radius: 1px;
    cursor: grab;
  }
  /* invisible fat hit area: the 3px handle is undraggable with a thumb */
  #tl-handle::before,
  .tl-edge::before {
    content: '';
    position: absolute;
    inset: -8px -12px;
  }
  #tl-readout {
    min-width: 3ch;
    text-align: right;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .legend {
    position: absolute;
    left: var(--space-4);
    bottom: calc(var(--space-3) + 3.4rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    font-size: var(--text-xs);
    color: var(--ink-dim);
    pointer-events: none;
  }
  .key {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 5px;
    background: var(--ink-dim);
    vertical-align: -1px;
  }
  .key-idea {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--ink-dim);
  }
  .key-building {
    animation: key-breathe 2.4s ease-in-out infinite;
  }
  .key-shipped {
    box-shadow: 0 0 5px var(--ink-dim);
  }
  .key-retired {
    opacity: var(--retired-dim);
  }
  .key-teaser {
    background: transparent;
    border: 1.5px dashed var(--ink-faint);
  }
  .legend-hint {
    color: var(--ink-faint);
  }
  @keyframes key-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  /* touch devices: fatter targets, no hover-dependent chrome */
  @media (pointer: coarse) {
    .drow {
      padding: 7px var(--space-2);
    }
    .tchip {
      padding: 4px 8px;
    }
    .tl-edge {
      width: 16px;
    }
    #tl-edge-l {
      left: -8px;
    }
    #tl-edge-r {
      right: -8px;
    }
    .node-close {
      padding: 6px 10px;
    }
    #map-tip {
      display: none; /* tooltip is a hover affordance; tap opens the modal */
    }
  }

  @media (max-width: 480px) {
    #tl-ticks :global(.tick-label) {
      display: none;
    }
    #timeline {
      gap: var(--space-2);
      padding: var(--space-2);
    }
  }

  @media (max-width: 640px) {
    #map-card {
      left: var(--space-4);
      right: var(--space-4);
      width: auto;
    }
    .node-shell {
      width: 100%;
      height: calc(100% - env(safe-area-inset-bottom, 0px));
    }
    #panel-toggle {
      display: inline-block;
    }
    #domain-panel .panel-body {
      display: none;
    }
    #domain-panel[data-open] .panel-body {
      display: grid;
      margin-top: var(--space-2);
    }
    .legend {
      left: auto;
      right: var(--space-4);
      justify-content: flex-end;
      max-width: 55%;
      bottom: auto;
      top: var(--space-3);
    }
    .legend-hint {
      display: none;
    }
  }
</style>
