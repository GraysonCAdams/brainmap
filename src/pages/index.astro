---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Lamp from '../components/Lamp.astro';
import { SITE } from '../site.config';
import { STATUSES, DOMAINS } from '../content.config';

const nodes = (await getCollection('nodes', (n) => n.data.visibility === 'public')).sort(
  (a, b) => b.data.started.valueOf() - a.data.started.valueOf(),
);
const featured = nodes
  .filter((n) => n.data.featured)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const fmt = (d: Date) => d.toISOString().slice(0, 7);
---

<Base>
  <Header />
  <main>
    <section class="intro">
      <h1>Ideas, and what became of them.</h1>
      <p>
        I'm {SITE.name}, a DevOps engineer who can't stop building things. This is a live map of
        the ideas I've had, the ones I shipped, and how I actually think through a problem: the
        constraints, the edge cases, the tradeoffs. <a href="/map">See it as a map</a>, or start
        below.
      </p>
    </section>

    {
      featured.length > 0 && (
        <section class="start-here">
          <h2 class="data">start here</h2>
          <ol>
            {featured.map((n) => (
              <li>
                <a href={`/idea/${n.id}`}>{n.data.title}</a>
                <span class="tagline">{n.data.tagline}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="log">
      <div class="filters data" role="group" aria-label="Filter the log">
        {STATUSES.map((s) => <button class="chip" data-filter-status={s}>{s}</button>)}
        <span class="filter-sep" aria-hidden="true"></span>
        {DOMAINS.map((d) => <button class="chip" data-filter-domain={d}>{d}</button>)}
      </div>

      <table>
        <thead class="data">
          <tr>
            <th></th>
            <th>idea</th>
            <th class="col-tagline">what it is</th>
            <th>domain</th>
            <th>since</th>
          </tr>
        </thead>
        <tbody>
          {
            nodes.map((n) => (
              <tr data-status={n.data.status} data-domain={n.data.domain}>
                <td class="col-lamp">
                  <Lamp domain={n.data.domain} status={n.data.status} />
                </td>
                <td class="col-title">
                  <a href={`/idea/${n.id}`}>{n.data.title}</a>
                </td>
                <td class="col-tagline">{n.data.tagline}</td>
                <td class="data col-domain">{n.data.domain}</td>
                <td class="data col-date">{fmt(n.data.started)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </main>
</Base>

<script>
  // Filter chips: multiple selections union within a facet, intersect across
  // facets. No selection in a facet = facet inactive.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tbody tr')];
  const apply = () => {
    const on = (attr: string) =>
      chips.filter((c) => c.hasAttribute(attr) && c.ariaPressed === 'true').map((c) => c.getAttribute(attr));
    const statuses = on('data-filter-status');
    const domains = on('data-filter-domain');
    for (const r of rows) {
      const okS = statuses.length === 0 || statuses.includes(r.dataset.status ?? '');
      const okD = domains.length === 0 || domains.includes(r.dataset.domain ?? '');
      r.hidden = !(okS && okD);
    }
  };
  for (const c of chips) {
    c.ariaPressed = 'false';
    c.addEventListener('click', () => {
      c.ariaPressed = c.ariaPressed === 'true' ? 'false' : 'true';
      apply();
    });
  }
</script>

<style>
  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
  }
  .intro {
    padding: var(--space-12) 0 var(--space-8);
    max-width: var(--measure);
  }
  .intro h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
  }
  .intro p {
    color: var(--ink-dim);
    margin: var(--space-4) 0 0;
  }
  .intro a {
    color: var(--ink);
  }

  h2.data {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    text-transform: lowercase;
  }

  .start-here {
    border-top: 1px solid var(--line);
    padding: var(--space-3) 0 var(--space-6);
  }
  .start-here ol {
    margin: var(--space-3) 0 0;
    padding: 0 0 0 1.4rem;
    display: grid;
    gap: var(--space-2);
  }
  .start-here li::marker {
    font-family: var(--font-data);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }
  .start-here .tagline {
    color: var(--ink-faint);
    margin-left: var(--space-2);
    font-size: var(--text-sm);
  }

  .log {
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-4);
  }
  .filter-sep {
    width: 1px;
    height: 14px;
    background: var(--line);
  }
  .chip {
    font: inherit;
    font-size: var(--text-xs);
    color: var(--ink-dim);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: 2px 8px;
    cursor: pointer;
  }
  .chip:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
  .chip[aria-pressed='true'] {
    color: var(--ground);
    background: var(--ink);
    border-color: var(--ink);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  thead th {
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-faint);
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: baseline;
  }
  .col-lamp {
    width: 1.2rem;
  }
  .col-title a {
    text-decoration: none;
    font-weight: 500;
  }
  .col-title a:hover {
    text-decoration: underline;
  }
  .col-tagline {
    color: var(--ink-dim);
  }
  .col-domain,
  .col-date {
    color: var(--ink-faint);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .col-tagline {
      display: none;
    }
  }
</style>
