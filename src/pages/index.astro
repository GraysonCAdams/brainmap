---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site.config';
---

<Base>
  <Header />
  <main>
    <div id="map-root">
      <noscript>
        The map needs JavaScript. Everything on it is also in <a href="/bio">the bio</a>.
      </noscript>
    </div>

    <aside id="map-card" hidden>
      <button class="card-close data" aria-label="Close">esc</button>
      <p class="card-meta data"></p>
      <h2 class="card-title"></h2>
      <p class="card-tagline"></p>
      <a class="card-link" href="/">read the full story &rarr;</a>
    </aside>

    <!-- whoami modal: first-visit overview, dismissable, remembered -->
    <div id="intro" class="intro-backdrop" hidden>
      <section class="intro-modal" role="dialog" aria-modal="true" aria-labelledby="intro-title">
        <p id="intro-title" class="data intro-cmd"><span class="prompt">$</span> whoami</p>
        <p class="intro-name data">{SITE.name}</p>
        <p class="intro-text">
          Lead DevOps engineer who can't stop building things. Every dot on this map is an idea I
          had; the bright ones shipped. Click any of them to see how I actually think through a
          problem: constraints, edge cases, tradeoffs.
        </p>
        <div class="intro-actions data">
          <button id="intro-close" autofocus>[ explore the map ]</button>
          <a href="/bio">./bio</a>
          <a href="/resume">./resume</a>
        </div>
      </section>
    </div>

    <footer class="legend data" aria-label="How to read the map">
      <span><i class="key key-idea"></i>idea</span>
      <span><i class="key key-building"></i>building</span>
      <span><i class="key key-shipped"></i>shipped</span>
      <span><i class="key key-retired"></i>retired</span>
      <span><i class="key key-teaser"></i>in stealth</span>
      <span class="legend-hint">color = domain · drag to pan · pinch or scroll to zoom</span>
    </footer>
  </main>
</Base>

<script src="../scripts/map.ts"></script>

<script>
  // Intro modal: show until dismissed once on this device.
  const KEY = 'brainmap-intro-dismissed';
  const backdrop = document.getElementById('intro') as HTMLElement;
  const close = () => {
    backdrop.hidden = true;
    localStorage.setItem(KEY, '1');
  };
  if (!localStorage.getItem(KEY)) {
    backdrop.hidden = false;
    document.getElementById('intro-close')?.focus();
  }
  document.getElementById('intro-close')?.addEventListener('click', close);
  backdrop.addEventListener('click', (ev) => {
    if (ev.target === backdrop) close();
  });
  addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && !backdrop.hidden) close();
  });
</script>

<style>
  /* The map page owns the viewport: no document scroll, main fills the rest. */
  :global(body) {
    overflow: hidden;
    height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  main {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    /* graph-paper texture: map surface only, per DESIGN.md */
    background-image:
      linear-gradient(var(--line-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  #map-root {
    position: absolute;
    inset: 0;
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }
  noscript {
    display: grid;
    place-items: center;
    height: 100%;
  }

  #map-card {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    width: min(22rem, calc(100% - 2rem));
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-top: 2px solid var(--lamp, var(--line));
    border-radius: var(--radius-chip);
    padding: var(--space-4);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
  }
  .card-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    font: inherit;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: 1px 6px;
    cursor: pointer;
  }
  .card-close:hover {
    color: var(--ink);
  }
  .card-meta {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin: 0 0 var(--space-2);
    padding-right: var(--space-8);
  }
  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .card-tagline {
    color: var(--ink-dim);
    font-size: var(--text-sm);
    margin: var(--space-2) 0 var(--space-3);
  }
  .card-link {
    font-size: var(--text-sm);
  }

  .intro-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(6 10 11 / 0.72);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    z-index: 10;
  }
  .intro-modal {
    width: min(27rem, 100%);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: var(--space-6);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.55);
  }
  .intro-cmd {
    font-size: var(--text-sm);
    color: var(--ink-dim);
    margin: 0;
  }
  .intro-cmd .prompt {
    color: var(--lamp-finance);
  }
  .intro-name {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: var(--space-2) 0 var(--space-3);
  }
  .intro-text {
    font-size: var(--text-sm);
    color: var(--ink-dim);
    margin: 0 0 var(--space-4);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: baseline;
    font-size: var(--text-sm);
  }
  .intro-actions button {
    font: inherit;
    color: var(--ground);
    background: var(--ink);
    border: none;
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .intro-actions button:hover {
    opacity: 0.88;
  }
  .intro-actions a {
    color: var(--ink-dim);
    text-decoration: none;
  }
  .intro-actions a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .legend {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    font-size: var(--text-xs);
    color: var(--ink-dim);
    pointer-events: none;
  }
  .key {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 5px;
    background: var(--ink-dim);
    vertical-align: -1px;
  }
  .key-idea {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--ink-dim);
  }
  .key-building {
    animation: key-breathe 2.4s ease-in-out infinite;
  }
  .key-shipped {
    box-shadow: 0 0 5px var(--ink-dim);
  }
  .key-retired {
    opacity: var(--retired-dim);
  }
  .key-teaser {
    background: transparent;
    border: 1.5px dashed var(--ink-faint);
  }
  .legend-hint {
    color: var(--ink-faint);
  }
  @keyframes key-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (max-width: 640px) {
    #map-card {
      left: var(--space-4);
      right: var(--space-4);
      width: auto;
    }
    .legend {
      bottom: auto;
      top: var(--space-3);
    }
    .legend-hint {
      display: none;
    }
  }
</style>
