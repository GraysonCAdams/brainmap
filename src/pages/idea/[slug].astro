---
import { getCollection, render } from 'astro:content';
import { DOMAIN_LABELS } from '../../content.config';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Lamp from '../../components/Lamp.astro';
import Constellation from '../../components/Constellation.astro';

export async function getStaticPaths() {
  const all = await getCollection('nodes');
  const pub = all.filter((n) => n.data.visibility === 'public');
  return pub.map((node) => {
    // Undirected neighborhood: my links plus anyone linking to me.
    // Teaser neighbors appear (presence is public) but don't link anywhere.
    const ids = new Set(node.data.links);
    for (const other of all) {
      if (other.data.links.includes(node.id)) ids.add(other.id);
    }
    ids.delete(node.id);
    const neighbors = all
      .filter((n) => ids.has(n.id))
      .map((n) => ({
        id: n.id,
        title: n.data.title,
        domain: n.data.domain,
        teaser: n.data.visibility === 'teaser',
      }));
    // Containment is shown as its own relationship, not folded into the
    // neighbourhood: "this is one part of that" and "these are related ideas"
    // are different claims and a reader should not have to tell them apart.
    const parent = node.data.parent
      ? all.find((n) => n.id === node.data.parent)
      : undefined;
    const children = all
      .filter((n) => n.data.parent === node.id && n.data.visibility === 'public')
      .sort((a, b) => a.data.started.getTime() - b.data.started.getTime())
      .map((n) => ({
        id: n.id,
        title: n.data.title,
        tagline: n.data.tagline,
        year: n.data.started.getUTCFullYear(),
      }));
    return {
      params: { slug: node.id },
      props: {
        node,
        neighbors,
        children,
        parent: parent ? { id: parent.id, title: parent.data.title } : null,
      },
    };
  });
}

const { node, neighbors, parent, children } = Astro.props;
const { Content } = await render(node);
const since = node.data.started.toISOString().slice(0, 10);

import enrichment from '../../data/enrichment.json';
const repoInfo = (enrichment as Record<string, any>)[node.id];
const lastActive =
  repoInfo && !repoInfo.missing && repoInfo.pushedAt
    ? repoInfo.pushedAt.slice(0, 10)
    : null;
---

<Base title={node.data.title} description={node.data.tagline}>
  <Header />
  <main>
    <article>
      <header class="plate" style={`--lamp: var(--lamp-${node.data.domain})`}>
        <p class="plate-meta data">
          <Lamp domain={node.data.domain} status={node.data.status} />
          <span>{node.data.status}</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>{DOMAIN_LABELS[node.data.domain]}</span>
          <span class="sep" aria-hidden="true">·</span>
          <time datetime={since}>{since}</time>
          {
            node.data.repo && (
              <>
                <span class="sep" aria-hidden="true">·</span>
                <a href={`https://github.com/${node.data.repo}`}>{node.data.repo}</a>
              </>
            )
          }
          {
            lastActive && (
              <>
                <span class="sep" aria-hidden="true">·</span>
                <span>last active {lastActive}</span>
              </>
            )
          }
        </p>
        {
          parent && (
            <p class="up">
              part of <a href={`/idea/${parent.id}`}>{parent.title}</a>
            </p>
          )
        }
        <h1>{node.data.title}</h1>
        <p class="tagline">{node.data.tagline}</p>
        {
          node.data.tech.length > 0 && (
            <p class="tech data">{node.data.tech.join(' · ')}</p>
          )
        }
      </header>

      <Constellation domain={node.data.domain} neighbors={neighbors} />

      <div class="prose">
        <Content />
      </div>

      {
        children.length > 0 && (
          <section class="parts">
            <h2 class="data">written up separately</h2>
            <ul>
              {children.map((c) => (
                <li>
                  <a href={`/idea/${c.id}`}>
                    <span class="part-year data">{c.year}</span>
                    <span class="part-title">{c.title}</span>
                    <span class="part-tagline">{c.tagline}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>
  <Footer />
</Base>

<style>
  main {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
  }
  .plate {
    padding: var(--space-8) 0 0;
  }
  .plate-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--ink-dim);
    margin: 0 0 var(--space-3);
  }
  .plate-meta .sep {
    color: var(--ink-faint);
  }
  .plate h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
  }
  .tagline {
    color: var(--ink-dim);
    font-size: var(--text-lg);
    margin: var(--space-2) 0 0;
  }
  .tech {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin: var(--space-3) 0 0;
  }
  .up {
    font-size: var(--text-sm);
    color: var(--ink-faint);
    margin: 0 0 var(--space-1);
  }
  .up a {
    color: var(--ink-dim);
  }

  /* The children of a node are its evidence, so they get the weight of a real
     list rather than the chip treatment used for lateral links. */
  .parts {
    margin-top: var(--space-10);
    border-top: 1px solid var(--line-faint);
    padding-top: var(--space-3);
  }
  .parts h2 {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin: 0 0 var(--space-2);
  }
  .parts ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .parts a {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line-faint);
    text-decoration: none;
    color: var(--ink);
  }
  .parts li:last-child a {
    border-bottom: 0;
  }
  .part-year {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    /* Optical: sit on the title's baseline, not the row's top edge. */
    padding-top: 0.15em;
  }
  .part-tagline {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--ink-dim);
    text-wrap: pretty;
  }
  .parts a:hover .part-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose {
    font-size: var(--text-base);
  }
  .prose :global(h2) {
    font-family: var(--font-data);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: var(--ink-faint);
    border-top: 1px solid var(--line-faint);
    padding-top: var(--space-3);
    margin: var(--space-8) 0 var(--space-3);
  }
  .prose :global(p) {
    margin: 0 0 var(--space-4);
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--ink);
  }
  .prose :global(code) {
    font-size: 0.88em;
    background: var(--surface);
    padding: 1px 4px;
    border-radius: var(--radius-chip);
  }
</style>
