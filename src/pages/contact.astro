---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Public Turnstile site key: injected at build (CF Pages env var). The widget
// renders only when configured, so local/dev builds degrade gracefully.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined;
---

<Base title="Contact" description="Get in touch.">
  <Header />
  <main>
    <h1>Contact</h1>
    <p class="lede">
      Recruiter, fellow builder, or someone who spotted a dead link: all welcome.
    </p>

    <form method="post" action="/api/contact" id="contact-form">
      <label>
        <span class="data">your name</span>
        <input name="name" required maxlength="120" autocomplete="name" />
      </label>
      <label>
        <span class="data">reply-to email</span>
        <input name="email" type="email" required maxlength="200" autocomplete="email" />
      </label>
      <label>
        <span class="data">message</span>
        <textarea name="message" required rows="6" maxlength="4000"></textarea>
      </label>
      {sitekey && <div class="cf-turnstile" data-sitekey={sitekey} data-theme="dark" />}
      <button type="submit">Send message</button>
      <p class="status data" role="status" aria-live="polite"></p>
    </form>
  </main>
  <Footer />
</Base>

{sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLElement;
  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    status.textContent = 'sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const body = await res.json().catch(() => ({}));
      if (res.ok) {
        status.textContent = 'Sent. I read these directly and will reply by email.';
        form.reset();
      } else {
        status.textContent = body.error ?? 'That did not send. Email me instead (link in the footer).';
      }
    } catch {
      status.textContent = 'Network error. Email me instead (link in the footer).';
    }
  });
</script>

<style>
  main {
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-12);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
  }
  .lede {
    color: var(--ink-dim);
    margin: var(--space-2) 0 var(--space-6);
  }
  form {
    display: grid;
    gap: var(--space-4);
  }
  label {
    display: grid;
    gap: var(--space-1);
  }
  label span {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }
  input,
  textarea {
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-3);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ink-faint);
  }
  button {
    justify-self: start;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ground);
    background: var(--ink);
    border: none;
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }
  button:hover {
    opacity: 0.88;
  }
  .status {
    font-size: var(--text-xs);
    color: var(--ink-dim);
    min-height: 1.2em;
    margin: 0;
  }
</style>
