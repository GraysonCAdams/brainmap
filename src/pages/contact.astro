---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Public Turnstile site key: injected at build (CF Pages env var). The widget
// renders only when configured, so local/dev builds degrade gracefully.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined;
---

<Base title="Contact" description="Get in touch.">
  <Header />
  <main id="main" tabindex="-1">
    <h1>Contact</h1>
    <p class="lede">
      Recruiter, fellow builder, or someone who spotted a dead link: all welcome.
    </p>

    <form method="post" action="/api/contact" id="contact-form">
      {/* Every field is required, so one statement is clearer than three
          asterisks. aria-describedby carries it into each field's own
          announcement, where a reader tabbing straight to an input will
          otherwise never meet it. */}
      <p class="required-note data" id="required-note">All three fields are required.</p>
      <label>
        <span class="data">your name</span>
        <input name="name" required maxlength="120" autocomplete="name" aria-describedby="required-note" />
      </label>
      <label>
        <span class="data">reply-to email</span>
        <input
          name="email"
          type="email"
          required
          maxlength="200"
          autocomplete="email"
          aria-describedby="required-note"
        />
      </label>
      <label>
        <span class="data">message</span>
        <textarea name="message" required rows="6" maxlength="4000" aria-describedby="required-note"
        ></textarea>
      </label>
      {sitekey && <div class="cf-turnstile" data-sitekey={sitekey} data-theme="dark" />}
      <button type="submit">Send message</button>
      {/* One region for both outcomes. aria-atomic so a reader hears the whole
          new sentence rather than the words that happen to differ from the
          last one. */}
      <p class="status data" role="status" aria-live="polite" aria-atomic="true"></p>
    </form>
  </main>
  <Footer />
</Base>

{sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLElement;
  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    delete status.dataset.state;
    status.textContent = 'sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const body = await res.json().catch(() => ({}));
      if (res.ok) {
        status.dataset.state = 'ok';
        status.textContent = 'Sent. I read these directly and will reply by email.';
        form.reset();
      } else {
        fail(body.error ?? 'That did not send. Email me instead (link in the footer).');
      }
    } catch {
      fail('Network error. Email me instead (link in the footer).');
    }
  });

  // "Error:" in the text, not just a colour: the failure has to survive being
  // read aloud and being read by someone who cannot separate the two states by
  // hue. The colour is the second channel, not the only one.
  function fail(message: string) {
    status.dataset.state = 'error';
    status.textContent = `Error: ${message}`;
  }
</script>

<style>
  main {
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-12);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
  }
  .lede {
    color: var(--ink-dim);
    margin: var(--space-2) 0 var(--space-6);
  }
  form {
    display: grid;
    gap: var(--space-4);
  }
  label {
    display: grid;
    gap: var(--space-1);
  }
  label span {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }
  .required-note {
    font-size: var(--text-xs);
    color: var(--ink-dim);
    margin: 0;
  }
  input,
  textarea {
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
    background: var(--surface);
    /* --surface against --ground is 1.13:1, so this border is the only thing
       saying where the field is. It has to carry the 3:1 that WCAG 1.4.11
       asks of a control boundary, which --line does not. */
    border: 1px solid var(--line-control);
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-3);
    min-height: 40px;
  }
  /* The border warming up is a nice touch and not a focus indicator: one
     pixel changing tone is not enough to find with a keyboard. Keep the
     global ring and let the border shift ride along with it. */
  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--ink-faint);
  }
  button {
    justify-self: start;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ground);
    background: var(--ink);
    border: none;
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-4);
    min-height: 44px;
    cursor: pointer;
    transition-property: scale, background-color;
    transition-duration: 120ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }
  /* Shifting the fill rather than fading the button: opacity takes the dark
     label down with the plate, so the one word that matters gets harder to
     read on hover. */
  button:hover {
    background: color-mix(in srgb, var(--ink) 86%, var(--ground));
  }
  button:active {
    scale: 0.96;
  }
  .status {
    font-size: var(--text-xs);
    color: var(--ink-dim);
    min-height: 1.2em;
    margin: 0;
  }
  .status[data-state='ok'] {
    color: var(--ink);
  }
  .status[data-state='error'] {
    color: var(--lamp-products-text);
  }
  @media (prefers-reduced-motion: reduce) {
    button:active {
      scale: none;
    }
  }
</style>
